# /opt/good/.env on the host, or .env.local in development.
GOOD_VERSION=latest
# Where the web port binds; put a reverse proxy with TLS in front.
GOOD_BIND=127.0.0.1:3000

# (OTLP/JSON); leave the endpoint empty to send nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=good
